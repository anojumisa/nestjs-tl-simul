# Copy this file to .env and fill values.
# Never commit .env (already ignored by .gitignore).

# App
PORT=3000

# Repository binding
# - (empty / not set) => InMemoryCourseRepository
# - demo-seed         => DemoSeedCourseRepository
# - postgres          => PostgresCourseRepository (raw SQL)
COURSE_REPOSITORY_IMPL=postgres

# Database (choose ONE approach)

# Option A: single URL
DATABASE_URL=postgresql://fauzan:revou123@localhost:5432/revou_nest

# Option B: split params (used if DATABASE_URL is empty)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=learning_platform

