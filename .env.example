# Copy this file to .env and fill values.
# Never commit .env (already ignored by .gitignore).

# App
PORT=3000

# Repository binding
# - (empty / not set) => InMemoryCourseRepository
# - demo-seed         => DemoSeedCourseRepository
# - postgres          => PostgresCourseRepository (raw SQL)
# - prisma            => PrismaCourseRepository (ORM Prisma)
COURSE_REPOSITORY_IMPL=prisma

# Database (choose ONE approach)

# Option A: single URL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/learning_platform

# Option B: split params (used if DATABASE_URL is empty)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=learning_platform

# JWT (Step 18) — wajib untuk login & route terlindungi
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRES_IN=1d

